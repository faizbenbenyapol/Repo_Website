# ── ค่าที่ compose ใช้ ────────────────────────────────
# แท็กอิมเมจที่จะรันบนเซิร์ฟเวอร์ (ใช้ตอน rollback: IMAGE_TAG=v0.1.0)
IMAGE_TAG=latest
# โดเมนที่ Caddy จะขอใบรับรอง TLS ให้
SITE_DOMAIN=repo.benyapol.com
# อีเมลสำหรับ Let's Encrypt
ACME_EMAIL=you@example.com

# ── ค่าที่แอปใช้ ─────────────────────────────────────
# ต้นทาง API ที่ web ใช้ proxy ให้เบราว์เซอร์ (ในคอนเทนเนอร์ชี้ที่ชื่อ service)
API_ORIGIN=http://api:3001
# ส่งคุกกี้ session เฉพาะบน HTTPS — เว้นว่างไว้เพื่อให้ตัดสินจาก NODE_ENV เอง
# ตั้ง 0 เฉพาะตอนที่ต้องเข้าใช้ผ่าน http จริง ๆ เท่านั้น
COOKIE_SECURE=

# กุญแจสำหรับเข้ารหัส API key ของสมาชิก (สร้างด้วย: openssl rand -hex 32)
# ต้องมีค่านี้เสมอบนเซิร์ฟเวอร์จริง ถ้าเปลี่ยนค่า กุญแจที่ผู้ใช้ผูกไว้ทั้งหมดจะถอดไม่ออกและต้องใส่ใหม่
SESSION_SECRET=

# ── ฐานข้อมูลและคิวงาน ───────────────────────────────
# รหัสผ่าน Postgres บนเซิร์ฟเวอร์จริง (สร้างด้วย: openssl rand -hex 24)
POSTGRES_PASSWORD=
# จำนวนงานวิเคราะห์ที่รันพร้อมกันได้
WORKER_CONCURRENCY=2
# เพดานจำนวนไฟล์ต่อ repo หนึ่งตัว
MAX_FILES=50000

# ── ชั้นความเข้าใจ (สรุปด้วย AI) ──────────────────────
# จำนวนงานสรุปที่รันพร้อมกันได้ — ตั้งไว้ต่ำเพราะแต่ละงานยิงโมเดลหลายร้อยครั้ง
COMPREHENSION_CONCURRENCY=1
# เพดานจำนวนไฟล์ที่ส่งให้โมเดลอ่านต่อการสรุปหนึ่งรอบ ที่เหลือระบบเขียนคำอธิบายเองจากโครงสร้าง
COMPREHEND_MAX_FILES=400
# จำนวนครั้งที่สมาชิกหนึ่งคนสั่งสรุปได้ต่อหนึ่งชั่วโมง
COMPREHENSION_RATE_LIMIT=5
